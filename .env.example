# Supabase Postgres connection (DIRECT_DATABASE_URL is optional, used by
# drizzle-kit for migrations that need a non-pooled connection).
DATABASE_URL=
DIRECT_DATABASE_URL=

# Auth: signing key for the session JWT, and the password checked at /login
# alongside the rotating security question.
JWT_SECRET_KEY=
LOGIN_PASSWORD=

# Infomaniak Drive API credentials and file/dir IDs (metadata, login QA list,
# trace storage).
INFOMANIAK_DRIVE_SECRET=
INFOMANIAK_DRIVE_ID=
INFOMANIAK_METADATA_ID=
INFOMANIAK_LOGIN_QA_ID=
INFOMANIAK_TRACE_DIR_ID=

# Client-side Mapbox GL token.
NEXT_PUBLIC_MAPBOX_TOKEN=
